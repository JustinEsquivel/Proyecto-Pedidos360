@model Pedidos360.Models.ViewModels.ProductosIndexVM
@using Pedidos360.Models
@{
    ViewData["Title"] = "Productos";
    var carouselItems = ViewBag.ProductosCarousel as List<Producto> ?? new List<Producto>();
    var gradients = new[]
    {
        "linear-gradient(135deg,#667eea,#764ba2)",
        "linear-gradient(135deg,#f093fb,#f5576c)",
        "linear-gradient(135deg,#4facfe,#00f2fe)",
        "linear-gradient(135deg,#43e97b,#38f9d7)",
        "linear-gradient(135deg,#fa709a,#fee140)",
        "linear-gradient(135deg,#a18cd1,#fbc2eb)",
        "linear-gradient(135deg,#fda085,#f6d365)",
        "linear-gradient(135deg,#30cfd0,#330867)"
    };
}

<style>
    /* ── Carousel ── */
    #carouselProductos { background: #0f172a; }
    .carousel-slide-img {
        width: 100%; height: 460px;
        object-fit: contain; object-position: center;
        filter: brightness(.9);
    }
    .carousel-slide-placeholder {
        width: 100%; height: 460px;
        display: flex; align-items: center; justify-content: center;
    }
    .carousel-caption-custom {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,.75) 0%, transparent 100%);
        padding: 3rem 3rem 2rem;
        text-align: left;
    }
    .carousel-caption-custom h2 { font-size: 2.2rem; font-weight: 700; text-shadow: 0 2px 8px rgba(0,0,0,.5); }
    .carousel-caption-custom .price-tag {
        display: inline-block;
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff; font-size: 1.3rem; font-weight: 700;
        border-radius: .5rem; padding: .25rem .9rem;
    }
    .carousel-control-prev-icon, .carousel-control-next-icon {
        background-color: rgba(0,0,0,.4);
        border-radius: 50%;
        padding: 1.2rem;
        background-size: 60%;
    }
    /* ── Product cards ── */
    .product-card {
        border: none;
        border-radius: 1rem;
        transition: transform .22s, box-shadow .22s;
        overflow: hidden;
    }
    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0,0,0,.14) !important;
    }
    .product-img-wrap {
        height: 210px; overflow: hidden; position: relative;
        background: #f4f5f7;
    }
    .product-img-wrap img {
        width: 100%; height: 210px; object-fit: contain;
        transition: transform .4s;
        padding: .5rem;
    }
    .product-card:hover .product-img-wrap img { transform: scale(1.04); }
    .product-img-placeholder {
        height: 210px;
        display: flex; align-items: center; justify-content: center;
        font-size: 3.5rem; color: rgba(255,255,255,.8);
    }
    .category-badge {
        position: absolute; top: .6rem; left: .6rem;
        background: rgba(0,0,0,.55);
        backdrop-filter: blur(4px);
        color: #fff; font-size: .7rem;
        border-radius: .4rem; padding: .2rem .5rem;
    }
    .inactive-overlay {
        position: absolute; inset: 0;
        background: rgba(0,0,0,.45);
        display: flex; align-items: center; justify-content: center;
    }
    /* ── Filter bar ── */
    .filter-card { border: none; border-radius: .875rem; }
    /* ── Section header ── */
    .section-title {
        font-size: .75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .08em; color: #6b7280;
    }
</style>

@* ─── CAROUSEL full-width ─── *@
@section FullWidth {
    @if (carouselItems.Any())
    {
        <div id="carouselProductos" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3800">
            <div class="carousel-indicators">
                @for (int i = 0; i < carouselItems.Count; i++)
                {
                    <button type="button" data-bs-target="#carouselProductos" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Producto @(i+1)"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (int i = 0; i < carouselItems.Count; i++)
                {
                    var prod = carouselItems[i];
                    var grad = gradients[i % gradients.Length];
                    <div class="carousel-item @(i == 0 ? "active" : "")" style="position:relative;">
                        @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                        {
                            <img src="data:image/png;base64,@prod.ImagenUrl"
                                 class="carousel-slide-img d-block w-100"
                                 alt="@prod.Nombre" />
                        }
                        else
                        {
                            <div class="carousel-slide-placeholder d-block" style="background:@grad;">
                                <i class="bi bi-box-seam" style="font-size:6rem;color:rgba(255,255,255,.35);"></i>
                            </div>
                        }
                        <div class="carousel-caption-custom text-white">
                            <p class="mb-1 opacity-75 small text-uppercase fw-semibold">
                                <i class="bi bi-tag-fill me-1"></i>@prod.Categoria?.Nombre
                            </p>
                            <h2 class="mb-2">@prod.Nombre</h2>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <span class="price-tag">₡@prod.Precio.ToString("N2")</span>
                                <span class="badge @(prod.Stock > 5 ? "bg-success" : prod.Stock > 0 ? "bg-warning text-dark" : "bg-danger") fs-6">
                                    <i class="bi bi-archive-fill me-1"></i>@prod.Stock en stock
                                </span>
                                <a asp-action="Details" asp-route-id="@prod.ProductoId"
                                   class="btn btn-sm btn-light fw-semibold">
                                    Ver detalle <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselProductos" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselProductos" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    }
}

@* ─── ALERTAS ─── *@
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Err"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ─── HEADER + FILTROS ─── *@
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <h4 class="fw-bold mb-0">Catálogo de Productos</h4>
        <p class="text-muted small mb-0">@Model.TotalItems producto(s) encontrado(s)</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
    {
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalNuevaCategoria">
                <i class="bi bi-tags me-1"></i>Nueva Categoría
            </button>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Nuevo Producto
            </a>
        </div>
    }
</div>

<div class="card filter-card shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Nombre</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input name="nombre" value="@Model.Nombre" class="form-control border-start-0" placeholder="Buscar producto..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Categoría</label>
                <select name="categoriaId" class="form-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var c in ViewBag.Categorias)
                    {
                        <option value="@c.Value" selected="@(Model.CategoriaId?.ToString() == c.Value)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Por página</label>
                <select name="pageSize" class="form-select">
                    @foreach (var s in new[] { 10, 15, 20, 30, 50 })
                    {
                        <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a class="btn btn-outline-secondary" asp-action="Index">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@* ─── GRID DE TARJETAS ─── *@
@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-box-seam display-3 opacity-25"></i>
        <p class="mt-3 fs-5">No se encontraron productos.</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        @{ int cardIdx = 0; }
        @foreach (var p in Model.Items)
        {
            var grad = gradients[cardIdx % gradients.Length];
            cardIdx++;
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card product-card shadow-sm h-100">
                    <div class="product-img-wrap">
                        @if (!string.IsNullOrEmpty(p.ImagenUrl))
                        {
                            <img src="data:image/png;base64,@p.ImagenUrl" alt="@p.Nombre" />
                        }
                        else
                        {
                            <div class="product-img-placeholder" style="background:@grad;">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        }
                        @if (p.Categoria != null)
                        {
                            <span class="category-badge">@p.Categoria.Nombre</span>
                        }
                        @if (!p.Activo)
                        {
                            <div class="inactive-overlay">
                                <span class="badge bg-dark fs-6">Inactivo</span>
                            </div>
                        }
                    </div>
                    <div class="card-body pb-2">
                        <h6 class="fw-bold mb-1 text-truncate" title="@p.Nombre">@p.Nombre</h6>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-primary fs-5">₡@p.Precio.ToString("N2")</span>
                            <span class="badge @(p.Stock > 5 ? "bg-success" : p.Stock > 0 ? "bg-warning text-dark" : "bg-danger")">
                                <i class="bi bi-archive-fill me-1"></i>@p.Stock
                            </span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-light text-muted border small">
                                <i class="bi bi-percent me-1"></i>IVA @p.ImpuestoPorc%
                            </span>
                            @if (p.Activo)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle small">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Inactivo</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 px-3">
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@p.ProductoId"
                               class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-eye me-1"></i>Detalle
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.ProductoId"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@p.ProductoId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ─── PAGINACIÓN ─── *@
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link" asp-route-nombre="@Model.Nombre" asp-route-categoriaId="@Model.CategoriaId"
                   asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int pg = 1; pg <= Model.TotalPages; pg++)
            {
                <li class="page-item @(pg == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-nombre="@Model.Nombre" asp-route-categoriaId="@Model.CategoriaId"
                       asp-route-pageSize="@Model.PageSize" asp-route-page="@pg">@pg</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-route-nombre="@Model.Nombre" asp-route-categoriaId="@Model.CategoriaId"
                   asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    <p class="text-center text-muted small">Página @Model.Page de @Model.TotalPages</p>
}

@* ─── MODAL NUEVA CATEGORÍA ─── *@
@if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
{
    <div class="modal fade" id="modalNuevaCategoria" tabindex="-1" aria-labelledby="modalNuevaCategoriaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalNuevaCategoriaLabel">
                        <i class="bi bi-tags me-2"></i>Nueva Categoría
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="alertaCategoria" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label for="inputNombreCategoria" class="form-label fw-semibold">
                            Nombre <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="inputNombreCategoria" class="form-control"
                               placeholder="Ej: Electrónica, Ropa, Alimentos…"
                               maxlength="100" />
                        <div class="form-text">Máximo 100 caracteres.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnGuardarCategoria" class="btn btn-primary">
                        <span id="spinnerCategoria" class="spinner-border spinner-border-sm me-1 d-none"></span>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    const modal = document.getElementById('modalNuevaCategoria');
    if (!modal) return; // solo para Admin/Ventas

    // Mover el modal como hijo directo de <body> para evitar problemas
    // de stacking context cuando está anidado dentro de contenedores.
    document.body.appendChild(modal);

    const inputNombre  = document.getElementById('inputNombreCategoria');
    const btnGuardar   = document.getElementById('btnGuardarCategoria');
    const spinner      = document.getElementById('spinnerCategoria');
    const alerta       = document.getElementById('alertaCategoria');
    const selectFiltro = document.querySelector('select[name="categoriaId"]');

    modal.addEventListener('show.bs.modal', function () {
        inputNombre.value = '';
        mostrarAlerta('', '');
    });

    modal.addEventListener('shown.bs.modal', function () {
        inputNombre.focus();
    });

    inputNombre.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); btnGuardar.click(); }
    });

    btnGuardar.addEventListener('click', async function () {
        const nombre = inputNombre.value.trim();

        if (!nombre) {
            mostrarAlerta('El nombre de la categoría es requerido.', 'danger');
            inputNombre.focus();
            return;
        }

        setBusy(true);
        mostrarAlerta('', '');

        try {
            const res = await fetch('/api/categorias', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nombre })
            });

            const data = await res.json();

            if (!res.ok) {
                mostrarAlerta(data.error ?? 'Ocurrió un error al guardar.', 'danger');
                return;
            }

            // Agregar la nueva categoría al select del filtro sin recargar
            if (selectFiltro) {
                const opt = document.createElement('option');
                opt.value       = data.id;
                opt.textContent = data.nombre;
                selectFiltro.appendChild(opt);
            }

            mostrarAlerta(`Categoría "${data.nombre}" creada correctamente.`, 'success');
            inputNombre.value = '';

            setTimeout(() => {
                bootstrap.Modal.getInstance(modal)?.hide();
            }, 1200);

        } catch {
            mostrarAlerta('No se pudo conectar con el servidor.', 'danger');
        } finally {
            setBusy(false);
        }
    });

    function mostrarAlerta(mensaje, tipo) {
        if (!mensaje) { alerta.className = 'alert d-none'; return; }
        alerta.className = `alert alert-${tipo}`;
        alerta.textContent = mensaje;
    }

    function setBusy(busy) {
        btnGuardar.disabled = busy;
        spinner.classList.toggle('d-none', !busy);
    }
})();
</script>
}
