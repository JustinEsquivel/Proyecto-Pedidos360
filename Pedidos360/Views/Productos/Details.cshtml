@model Pedidos360.Models.Producto
@{
    ViewData["Title"] = Model.Nombre;
    decimal precioBase       = Model.Precio;
    decimal impuesto         = Model.Precio * (Model.ImpuestoPorc / 100m);
    decimal precioFinal      = precioBase + impuesto;
    string  stockColor       = Model.Stock == 0 ? "danger" : Model.Stock < 10 ? "warning" : "success";
    string  stockLabel       = Model.Stock == 0 ? "Sin stock" : Model.Stock < 10 ? "Stock bajo" : "En stock";
    string  stockIcon        = Model.Stock == 0 ? "bi-x-circle-fill" : Model.Stock < 10 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";
    int     stockBarPct      = Math.Min(Model.Stock * 100 / (Model.Stock < 1 ? 1 : Math.Max(Model.Stock, 50)), 100);
}

<style>
    .product-hero-img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: contain;
        border-radius: 1rem;
        background: #f4f5f7;
        padding: 1rem;
    }
    .product-placeholder {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 100%);
        border-radius: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #aab4cc;
        border: 2px dashed #d0d8ea;
    }
    .price-tag {
        font-size: 2.4rem;
        font-weight: 800;
        color: #1a1a2e;
        line-height: 1;
    }
    .price-tax {
        font-size: 0.95rem;
        color: #6c757d;
    }
    .metric-card {
        border: none;
        border-radius: .875rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        transition: transform .15s;
    }
    .metric-card:hover { transform: translateY(-3px); }
    .metric-card .metric-icon {
        width: 48px; height: 48px;
        border-radius: .75rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
    }
    .metric-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .metric-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: #8a8fa8; }
    .info-panel {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 2px 16px rgba(0,0,0,.07);
    }
    .badge-cat {
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .03em;
        padding: .4em .85em;
        border-radius: 2rem;
    }
    .stock-bar-wrap { background: #e9ecef; border-radius: 4px; height: 8px; }
    .stock-bar-fill { height: 8px; border-radius: 4px; transition: width .4s; }
    .action-btn {
        border-radius: .625rem;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .92rem;
    }
    .breadcrumb-item + .breadcrumb-item::before { color: #adb5bd; }
</style>

@* Breadcrumb *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Productos</a></li>
        <li class="breadcrumb-item active">@Model.Nombre</li>
    </ol>
</nav>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Hero ── *@
<div class="row g-4 mb-4">

    @* Imagen *@
    <div class="col-lg-5 col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="data:image/png;base64,@Model.ImagenUrl"
                 alt="@Model.Nombre"
                 class="product-hero-img shadow" />
        }
        else
        {
            <div class="product-placeholder shadow-sm">
                <i class="bi bi-box-seam" style="font-size:4rem;"></i>
                <span class="mt-2 fw-semibold">Sin imagen</span>
            </div>
        }
        @* Estado badge debajo de la imagen en móvil *@
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <span class="badge badge-cat @(Model.Activo ? "bg-success" : "bg-secondary")">
                <i class="bi @(Model.Activo ? "bi-check-circle" : "bi-pause-circle") me-1"></i>
                @(Model.Activo ? "Producto activo" : "Inactivo")
            </span>
            <span class="badge badge-cat bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                <i class="bi bi-tag me-1"></i>@(Model.Categoria?.Nombre ?? "Sin categoría")
            </span>
        </div>
    </div>

    @* Info principal *@
    <div class="col-lg-7 col-md-7">
        <div class="info-panel card h-100 p-4">
            <div class="card-body p-0 d-flex flex-column">

                @* SKU / ID *@
                <p class="text-muted small mb-1">
                    <i class="bi bi-hash me-1"></i>SKU-@Model.ProductoId.ToString("D6")
                </p>

                @* Nombre *@
                <h1 class="fw-bold mb-3" style="font-size:1.9rem; color:#1a1a2e; line-height:1.2;">
                    @Model.Nombre
                </h1>

                <hr class="my-3">

                @* Precio *@
                <div class="mb-3">
                    <div class="price-tag">₡@precioFinal.ToString("N2")</div>
                    <div class="price-tax mt-1">
                        <span>Base: ₡@precioBase.ToString("N2")</span>
                        <span class="mx-2">·</span>
                        <span>IVA @Model.ImpuestoPorc.ToString("N1")%: ₡@impuesto.ToString("N2")</span>
                    </div>
                </div>

                <hr class="my-3">

                @* Stock *@
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-semibold">
                            <i class="bi @stockIcon text-@stockColor me-1"></i>
                            @stockLabel
                        </span>
                        <span class="fw-bold text-@stockColor fs-5">@Model.Stock unidades</span>
                    </div>
                    <div class="stock-bar-wrap">
                        <div class="stock-bar-fill bg-@stockColor"
                             style="width: @(Math.Min(Model.Stock * 2, 100))%;"></div>
                    </div>
                </div>

                @* Botones *@
                <div class="mt-auto d-flex gap-2 flex-wrap">
                    @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ProductoId"
                           class="btn btn-warning action-btn">
                            <i class="bi bi-pencil-square me-1"></i> Editar producto
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.ProductoId"
                           class="btn btn-outline-danger action-btn">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary action-btn ms-auto">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@* ── Métricas ── *@
<div class="row g-3">

    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <div class="metric-label">Precio base</div>
                    <div class="metric-value">₡@Model.Precio.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <div class="metric-label">Unidades en stock</div>
                    <div class="metric-value text-@stockColor">@Model.Stock</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-percent"></i>
                </div>
                <div>
                    <div class="metric-label">Impuesto (IVA)</div>
                    <div class="metric-value">@Model.ImpuestoPorc.ToString("N1")%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-grid"></i>
                </div>
                <div>
                    <div class="metric-label">Categoría</div>
                    <div class="metric-value" style="font-size:1.1rem;">@(Model.Categoria?.Nombre ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

</div>
