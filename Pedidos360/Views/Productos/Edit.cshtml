@model Pedidos360.Models.Producto
@{
    ViewData["Title"] = $"Editar — {Model.Nombre}";
}

<style>
    .edit-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.08);
    }
    .img-panel {
        background: linear-gradient(160deg, #f8f9ff 0%, #eef1fb 100%);
        border-radius: 1rem 0 0 1rem;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        border-right: 1px solid #e9ecef;
    }
    @@media (max-width: 767.98px) {
        .img-panel { border-radius: 1rem 1rem 0 0; border-right: none; border-bottom: 1px solid #e9ecef; }
    }
    .current-img {
        width: 100%;
        max-width: 260px;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: .875rem;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
    }
    .img-placeholder {
        width: 100%;
        max-width: 260px;
        aspect-ratio: 1 / 1;
        background: #e9ecef;
        border-radius: .875rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        border: 2px dashed #ced4da;
    }
    .img-preview-label {
        font-size: .78rem;
        color: #8a94a8;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-top: .5rem;
    }
    .form-panel { padding: 2.5rem; }
    @@media (max-width: 767.98px) { .form-panel { padding: 1.5rem; } }
    .section-divider {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #8a94a8;
        font-weight: 700;
        margin: 1.5rem 0 .75rem;
    }
    .section-divider::after {
        content: '';
        display: inline-block;
        height: 1px;
        background: #e9ecef;
        width: 100%;
        vertical-align: middle;
        margin-left: .75rem;
    }
    .field-icon {
        position: absolute;
        left: .85rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9aa5b4;
        pointer-events: none;
        font-size: .95rem;
    }
    .input-with-icon { padding-left: 2.25rem; }
    .input-group-currency .input-group-text {
        background: #f8f9fc;
        border-color: #dee2e6;
        font-weight: 600;
        color: #495057;
    }
    .toggle-label {
        display: flex;
        align-items: center;
        gap: .75rem;
        cursor: pointer;
        padding: .75rem 1rem;
        border: 1px solid #dee2e6;
        border-radius: .625rem;
        transition: border-color .15s, background .15s;
    }
    .toggle-label:has(input:checked) {
        border-color: #198754;
        background: #f0faf5;
    }
    .form-switch .form-check-input { width: 2.5em; height: 1.25em; }
    .save-btn {
        border-radius: .625rem;
        padding: .65rem 1.8rem;
        font-weight: 700;
        font-size: .95rem;
        letter-spacing: .02em;
    }
    .upload-zone {
        border: 2px dashed #ced4da;
        border-radius: .75rem;
        padding: 1rem;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        background: #f8f9fc;
    }
    .upload-zone:hover { border-color: #6c8ebf; background: #f0f4ff; }
    .upload-zone input[type=file] { display: none; }
    #previewContainer { display: none; }
</style>

@* Breadcrumb *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Productos</a></li>
        <li class="breadcrumb-item">
            <a asp-action="Details" asp-route-id="@Model.ProductoId" class="text-decoration-none">@Model.Nombre</a>
        </li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0" style="color:#1a1a2e;">
        <i class="bi bi-pencil-square me-2 text-warning"></i>Editar producto
    </h2>
    <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="font-size:.8rem;">
        SKU-@Model.ProductoId.ToString("D6")
    </span>
</div>

<div id="alertGeneral" class="alert alert-danger d-none"></div>

<div class="edit-card card">
    <div class="row g-0">

        @* ── Panel izquierdo: imagen ── *@
        <div class="col-md-4">
            <div class="img-panel h-100">
                <p class="img-preview-label mb-3">
                    <i class="bi bi-image me-1"></i>Imagen del producto
                </p>

                @* Imagen actual / placeholder *@
                <div id="currentImgWrap" style="width:100%; max-width:260px;">
                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <img id="imgActual"
                             src="data:image/png;base64,@Model.ImagenUrl"
                             alt="@Model.Nombre"
                             class="current-img" />
                    }
                    else
                    {
                        <div class="img-placeholder" id="imgActual">
                            <i class="bi bi-box-seam" style="font-size:3rem;"></i>
                            <span class="mt-2 small fw-semibold">Sin imagen</span>
                        </div>
                    }
                </div>

                @* Preview de nueva imagen *@
                <div id="previewContainer" style="width:100%; max-width:260px; margin-top:1rem;">
                    <img id="imgPreview" src="#" alt="Vista previa"
                         class="current-img border border-2 border-warning" />
                    <p class="img-preview-label text-warning mt-1">
                        <i class="bi bi-arrow-up-circle me-1"></i>Nueva imagen
                    </p>
                </div>

                @* Upload zone *@
                <div class="upload-zone mt-3 w-100" id="uploadZone" style="max-width:260px;"
                     onclick="document.getElementById('imagenFileInput').click()">
                    <input type="file" id="imagenFileInput" name="imagenFile"
                           accept="image/*" form="editForm" />
                    <i class="bi bi-cloud-arrow-up fs-4 text-muted d-block mb-1"></i>
                    <span class="text-muted small">
                        Haga clic para cambiar la imagen<br>
                        <span class="text-muted" style="font-size:.75rem;">JPG, PNG, WEBP</span>
                    </span>
                </div>
            </div>
        </div>

        @* ── Panel derecho: formulario ── *@
        <div class="col-md-8">
            <div class="form-panel">

                <form id="editForm"
                      asp-action="Edit"
                      asp-route-id="@Model.ProductoId"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductoId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @* ── Información básica ── *@
                    <div class="section-divider">Información básica</div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">
                            <i class="bi bi-tag me-1 text-muted"></i>Nombre del producto
                        </label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej. Laptop Dell Inspiron 15" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label fw-semibold">
                            <i class="bi bi-grid me-1 text-muted"></i>Categoría
                        </label>
                        <select asp-for="CategoriaId"
                                asp-items="ViewBag.Categorias"
                                class="form-select">
                            <option value="">— Seleccione una categoría —</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    @* ── Precios e impuestos ── *@
                    <div class="section-divider">Precio e impuestos</div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Precio" class="form-label fw-semibold">
                                <i class="bi bi-currency-dollar me-1 text-muted"></i>Precio base
                            </label>
                            <div class="input-group input-group-currency">
                                <span class="input-group-text">₡</span>
                                <input asp-for="Precio" type="number" step="0.01" min="0.01"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ImpuestoPorc" class="form-label fw-semibold">
                                <i class="bi bi-percent me-1 text-muted"></i>Impuesto (IVA)
                            </label>
                            <div class="input-group input-group-currency">
                                <input asp-for="ImpuestoPorc" type="number" step="0.01" min="0" max="100"
                                       class="form-control" placeholder="13.00" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="ImpuestoPorc" class="text-danger small"></span>
                        </div>
                    </div>

                    @* Precio con impuesto calculado en tiempo real *@
                    <div class="alert alert-light border py-2 px-3 mb-3" id="precioFinalWrap">
                        <small class="text-muted">Precio al cliente (con IVA):</small>
                        <strong class="ms-2 fs-6" id="lblPrecioFinal">
                            ₡@((Model.Precio * (1 + Model.ImpuestoPorc / 100m)).ToString("N2"))
                        </strong>
                    </div>

                    @* ── Inventario ── *@
                    <div class="section-divider">Inventario</div>

                    <div class="mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold">
                            <i class="bi bi-boxes me-1 text-muted"></i>Unidades en stock
                        </label>
                        <input asp-for="Stock" type="number" min="0"
                               class="form-control" placeholder="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="toggle-label form-check form-switch mb-0">
                            <input asp-for="Activo" class="form-check-input" role="switch" />
                            <div>
                                <div class="fw-semibold">Producto activo</div>
                                <div class="text-muted" style="font-size:.8rem;">Visible para ventas y pedidos</div>
                            </div>
                        </label>
                    </div>

                    @* ── Acciones ── *@
                    <div class="d-flex gap-2 pt-3 border-top flex-wrap">
                        <button id="btnGuardar" type="submit" class="btn btn-warning save-btn">
                            <i class="bi bi-floppy me-1"></i> Guardar cambios
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ProductoId"
                           class="btn btn-outline-secondary save-btn">
                            <i class="bi bi-eye me-1"></i> Ver detalle
                        </a>
                        <a class="btn btn-link text-muted save-btn ms-auto" asp-action="Index">
                            Cancelar
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    (function () {
        const form         = document.getElementById('editForm');
        const btnGuardar   = document.getElementById('btnGuardar');
        const alertGeneral = document.getElementById('alertGeneral');
        const inputPrecio  = document.querySelector('input[name="Precio"]');
        const inputIva     = document.querySelector('input[name="ImpuestoPorc"]');
        const lblFinal     = document.getElementById('lblPrecioFinal');
        const fileInput    = document.getElementById('imagenFileInput');
        const imgPreview   = document.getElementById('imgPreview');
        const previewCont  = document.getElementById('previewContainer');
        const currentWrap  = document.getElementById('currentImgWrap');

        // ── Precio final en tiempo real
        function calcPrecio() {
            const p = parseFloat(inputPrecio.value) || 0;
            const i = parseFloat(inputIva.value)    || 0;
            lblFinal.textContent = '₡' + (p * (1 + i / 100)).toLocaleString('es-CR', { minimumFractionDigits: 2 });
        }
        inputPrecio.addEventListener('input', calcPrecio);
        inputIva.addEventListener('input',    calcPrecio);

        // ── Preview de imagen nueva
        fileInput.addEventListener('change', function () {
            if (!this.files || !this.files[0]) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                imgPreview.src = e.target.result;
                previewCont.style.display = 'block';
                currentWrap.style.opacity = '0.4';
            };
            reader.readAsDataURL(this.files[0]);
        });

        // ── AJAX submit
        function clearServerErrors() {
            alertGeneral.classList.add('d-none');
            alertGeneral.textContent = '';
            form.querySelectorAll('span[data-valmsg-for]').forEach(s => {
                s.textContent = '';
                s.classList.remove('field-validation-error');
                s.classList.add('field-validation-valid');
            });
            const summary = form.querySelector('[data-valmsg-summary="true"]');
            if (summary) {
                summary.innerHTML = '';
                summary.classList.add('validation-summary-valid');
                summary.classList.remove('validation-summary-errors');
            }
        }

        function showServerErrors(errors) {
            const general = errors[''] || errors['ModelOnly'] || null;
            if (general && general.length) {
                alertGeneral.textContent = general.join(' ');
                alertGeneral.classList.remove('d-none');
            }
            Object.keys(errors).forEach(key => {
                if (!key) return;
                const span = form.querySelector(`span[data-valmsg-for="${key}"]`);
                if (span) {
                    span.textContent = errors[key].join(' ');
                    span.classList.remove('field-validation-valid');
                    span.classList.add('field-validation-error');
                }
            });
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearServerErrors();
            if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) return;

            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

            try {
                const formData = new FormData(form);
                // Añadir el archivo de imagen manualmente
                if (fileInput.files && fileInput.files[0]) {
                    formData.set('imagenFile', fileInput.files[0]);
                }

                const resp = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                if (resp.ok) {
                    const data = await resp.json();
                    window.location.href = data.redirectUrl;
                    return;
                }

                const errData = await resp.json();
                if (errData && errData.errors) {
                    showServerErrors(errData.errors);
                } else {
                    alertGeneral.textContent = 'Ocurrió un error inesperado.';
                    alertGeneral.classList.remove('d-none');
                }
            } catch {
                alertGeneral.textContent = 'No se pudo completar la solicitud.';
                alertGeneral.classList.remove('d-none');
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i class="bi bi-floppy me-1"></i> Guardar cambios';
            }
        });
    })();
    </script>
}
