@model Pedidos360.Models.Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="page-title">Pedido <span class="text-muted fw-normal">#@Model.PedidoId</span></h1>
            <p class="page-subtitle">
                @Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy  HH:mm", new System.Globalization.CultureInfo("es-CR"))
                &nbsp;·&nbsp;
                <span class="estado-badge badge-@Model.Estado.ToLower()">@Model.Estado</span>
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Estado == "Pendiente" && (User.IsInRole("Admin") || User.IsInRole("Ventas")))
            {
                <a asp-action="Edit" asp-route-id="@Model.PedidoId" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
                <form asp-action="CambiarEstado" asp-route-id="@Model.PedidoId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-check2-circle me-1"></i>Confirmar
                    </button>
                </form>
            }
            @if (Model.Estado == "Confirmado" && User.IsInRole("Admin"))
            {
                <form asp-action="CambiarEstado" asp-route-id="@Model.PedidoId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="bi bi-receipt-cutoff me-1"></i>Facturar
                    </button>
                </form>
            }
            <a asp-action="ExportarPdf" asp-route-id="@Model.PedidoId"
               class="btn btn-sm btn-export-pdf" target="_blank" title="Descargar factura en PDF">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </a>
            <a asp-action="Index" class="btn btn-sm btn-ghost">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show alert-modern">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show alert-modern">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Err"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-card-header">
                <i class="bi bi-receipt me-2"></i>Información del Pedido
            </div>
            <div class="info-card-body">
                <div class="info-row">
                    <span class="info-label">Fecha</span>
                    <span class="info-value">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Estado</span>
                    <span class="info-value">
                        <span class="estado-badge badge-@Model.Estado.ToLower()">@Model.Estado</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Vendedor</span>
                    <span class="info-value">@Model.Usuario?.NombreCompleto</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="info-card">
            <div class="info-card-header">
                <i class="bi bi-person-lines-fill me-2"></i>Cliente
            </div>
            <div class="info-card-body">
                <div class="info-row">
                    <span class="info-label">Nombre</span>
                    <span class="info-value fw-semibold">@Model.Cliente?.Nombre</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Cédula</span>
                    <span class="info-value">@Model.Cliente?.Cedula</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Correo</span>
                    <span class="info-value">@Model.Cliente?.Correo</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Teléfono</span>
                    <span class="info-value">@Model.Cliente?.Telefono</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-card mb-4">
    <div class="table-card-header">
        <i class="bi bi-box-seam me-2"></i>Detalle de Productos
    </div>
    <div class="table-responsive">
        <table class="table-modern w-100">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Precio Unit.</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Desc. %</th>
                    <th class="text-end">Impuesto %</th>
                    <th class="text-end">Total Línea</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td class="fw-medium">@d.Producto?.Nombre</td>
                        <td class="text-end text-muted">₡@d.PrecioUnit.ToString("N2")</td>
                        <td class="text-center">@d.Cantidad</td>
                        <td class="text-end text-muted">@d.Descuento.ToString("N2")%</td>
                        <td class="text-end text-muted">@d.ImpuestoPorc.ToString("N2")%</td>
                        <td class="text-end fw-semibold">₡@d.TotalLinea.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row justify-content-end mb-2">
    <div class="col-md-4 col-sm-6">
        <div class="totals-card">
            <div class="totals-row">
                <span>Subtotal</span>
                <span>₡@Model.Subtotal.ToString("N2")</span>
            </div>
            <div class="totals-row">
                <span>Impuestos</span>
                <span>₡@Model.Impuestos.ToString("N2")</span>
            </div>
            <div class="totals-row totals-total">
                <span>TOTAL</span>
                <span>₡@Model.Total.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>
