@model Pedidos360.Models.Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedido #@Model.PedidoId</h2>
    <div class="d-flex gap-2">
        @if (Model.Estado == "Pendiente" && (User.IsInRole("Admin") || User.IsInRole("Ventas")))
        {
            <form asp-action="CambiarEstado" asp-route-id="@Model.PedidoId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Confirmar Pedido</button>
            </form>
        }
        @if (Model.Estado == "Confirmado" && User.IsInRole("Admin"))
        {
            <form asp-action="CambiarEstado" asp-route-id="@Model.PedidoId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Facturar Pedido</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Err"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header fw-bold">Información del Pedido</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Estado == "Facturado" ? "bg-success" : Model.Estado == "Confirmado" ? "bg-primary" : "bg-warning text-dark")">
                            @Model.Estado
                        </span>
                    </dd>

                    <dt class="col-sm-4">Vendedor</dt>
                    <dd class="col-sm-8">@Model.Usuario?.NombreCompleto</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header fw-bold">Cliente</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Cliente?.Nombre</dd>

                    <dt class="col-sm-4">Cédula</dt>
                    <dd class="col-sm-8">@Model.Cliente?.Cedula</dd>

                    <dt class="col-sm-4">Correo</dt>
                    <dd class="col-sm-8">@Model.Cliente?.Correo</dd>

                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Cliente?.Telefono</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Detalle de Productos</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio Unit.</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Desc. %</th>
                        <th class="text-end">Impuesto %</th>
                        <th class="text-end">Total Línea</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@d.Producto?.Nombre</td>
                            <td class="text-end">₡@d.PrecioUnit.ToString("N2")</td>
                            <td class="text-center">@d.Cantidad</td>
                            <td class="text-end">@d.Descuento.ToString("N2")%</td>
                            <td class="text-end">@d.ImpuestoPorc.ToString("N2")%</td>
                            <td class="text-end fw-semibold">₡@d.TotalLinea.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row justify-content-end">
    <div class="col-md-4">
        <table class="table table-bordered">
            <tr>
                <th>Subtotal</th>
                <td class="text-end">₡@Model.Subtotal.ToString("N2")</td>
            </tr>
            <tr>
                <th>Impuestos</th>
                <td class="text-end">₡@Model.Impuestos.ToString("N2")</td>
            </tr>
            <tr class="table-dark">
                <th>TOTAL</th>
                <td class="text-end fw-bold fs-5">₡@Model.Total.ToString("N2")</td>
            </tr>
        </table>
    </div>
</div>
