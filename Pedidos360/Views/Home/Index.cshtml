@model Pedidos360.Models.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Inicio";
}

<style>
    .hero-banner {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
        border-radius: 1rem;
        position: relative;
        overflow: hidden;
    }
    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(99,102,241,0.3) 0%, transparent 70%);
        border-radius: 50%;
    }
    .hero-banner::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: 20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(16,185,129,0.2) 0%, transparent 70%);
        border-radius: 50%;
    }
    .stat-card {
        border: none;
        border-radius: .875rem;
        transition: transform .2s, box-shadow .2s;
        overflow: hidden;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,.15) !important;
    }
    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }
    .module-card {
        border: none;
        border-radius: 1rem;
        transition: transform .25s, box-shadow .25s;
        cursor: pointer;
        text-decoration: none;
        display: block;
    }
    .module-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0,0,0,.18) !important;
    }
    .module-card .card-body {
        padding: 2rem 1.5rem;
    }
    .module-icon {
        width: 72px;
        height: 72px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1rem;
    }
    .gradient-blue   { background: linear-gradient(135deg,#4361ee,#4cc9f0); }
    .gradient-green  { background: linear-gradient(135deg,#06b6d4,#10b981); }
    .gradient-orange { background: linear-gradient(135deg,#f59e0b,#ef4444); }
    .gradient-purple { background: linear-gradient(135deg,#8b5cf6,#ec4899); }
    .gradient-teal   { background: linear-gradient(135deg,#14b8a6,#3b82f6); }
    .table-recent th { font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; border-top: none; }
    .badge-estado-Pendiente  { background: #fef3c7; color: #92400e; }
    .badge-estado-Confirmado { background: #dbeafe; color: #1e40af; }
    .badge-estado-Facturado  { background: #d1fae5; color: #065f46; }
</style>

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="text-center py-5">
        <h1 class="display-5 fw-bold mb-2">Bienvenido a Pedidos360</h1>
        <p class="text-muted fs-5 mb-4">Sistema de gestión de pedidos, clientes y productos.</p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-5">
            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
        </a>
    </div>
}
else
{
    @* ── Hero Banner ── *@
    <div class="hero-banner p-4 p-md-5 mb-4 text-white shadow">
        <div style="position:relative;z-index:1;">
            <p class="mb-1 opacity-75 small text-uppercase letter-spacing-1">
                <i class="bi bi-speedometer2 me-1"></i>Panel de control
            </p>
            <h1 class="fw-bold mb-1" style="font-size:2rem;">Pedidos360</h1>
            <p class="opacity-75 mb-3">
                Hola, <strong>@User.Identity!.Name</strong> &nbsp;·&nbsp;
                @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"))
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                {
                    <a asp-controller="Pedidos" asp-action="Create" class="btn btn-sm btn-light fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i>Nuevo Pedido
                    </a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                {
                    <a asp-controller="Clientes" asp-action="Create" class="btn btn-sm btn-outline-light fw-semibold">
                        <i class="bi bi-person-plus me-1"></i>Nuevo Cliente
                    </a>
                }
            </div>
        </div>
    </div>

    @* ── Fila 1 de stats ── *@
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon gradient-blue text-white"><i class="bi bi-cart4"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Pedidos</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.TotalPedidos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon text-white" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Pendientes</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.PedidosPendientes</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon text-white" style="background:linear-gradient(135deg,#3b82f6,#60a5fa);"><i class="bi bi-check2-circle"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Confirmados</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.PedidosConfirmados</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon gradient-green text-white"><i class="bi bi-receipt-cutoff"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Facturados</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.PedidosFacturados</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Fila 2 de stats ── *@
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon gradient-purple text-white"><i class="bi bi-currency-dollar"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Total General (I.V.A.I)</div>
                        <div class="fw-bold" style="font-size:1.4rem;line-height:1.2;">
                            ₡@Model.TotalFacturado.ToString("N2")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon gradient-teal text-white"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Clientes</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.TotalClientes</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon text-white" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);"><i class="bi bi-box-seam-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Productos Activos</div>
                        <div class="fw-bold" style="font-size:2rem;line-height:1.1;">@Model.TotalProductos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="stat-icon text-white" style="background:linear-gradient(135deg,#ef4444,#f97316);"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">Bajo Stock (≤5)</div>
                        <div class="fw-bold @(Model.ProductosBajoStock > 0 ? "text-danger" : "")" style="font-size:2rem;line-height:1.1;">
                            @Model.ProductosBajoStock
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Acceso Rápido ── *@
    <h5 class="fw-bold text-muted mb-3 text-uppercase" style="font-size:.8rem;letter-spacing:.08em;">
        <i class="bi bi-grid-3x3-gap me-2"></i>Acceso Rápido
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <a asp-controller="Pedidos" asp-action="Index" class="module-card card shadow-sm text-center text-dark">
                <div class="card-body">
                    <div class="module-icon gradient-blue text-white shadow-sm">
                        <i class="bi bi-cart4"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Pedidos</h6>
                    <p class="text-muted small mb-0">Ver y gestionar pedidos</p>
                </div>
            </a>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
        {
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Clientes" asp-action="Index" class="module-card card shadow-sm text-center text-dark">
                    <div class="card-body">
                        <div class="module-icon gradient-teal text-white shadow-sm">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Clientes</h6>
                        <p class="text-muted small mb-0">Administrar clientes</p>
                    </div>
                </a>
            </div>
        }
        <div class="col-lg-3 col-md-6">
            <a asp-controller="Productos" asp-action="Index" class="module-card card shadow-sm text-center text-dark">
                <div class="card-body">
                    <div class="module-icon gradient-orange text-white shadow-sm">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-1">@(User.IsInRole("Operaciones") ? "Inventario" : "Productos")</h6>
                    <p class="text-muted small mb-0">Catálogo e inventario</p>
                </div>
            </a>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Usuarios" asp-action="Index" class="module-card card shadow-sm text-center text-dark">
                    <div class="card-body">
                        <div class="module-icon gradient-purple text-white shadow-sm">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Usuarios</h6>
                        <p class="text-muted small mb-0">Gestión de accesos</p>
                    </div>
                </a>
            </div>
        }
    </div>

    @* ── Pedidos Recientes ── *@
    @if (Model.PedidosRecientes.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Pedidos Recientes
                </h6>
                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    Ver todos <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 table-recent">
                        <thead>
                            <tr class="border-top-0">
                                <th class="ps-4">#</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Vendedor</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PedidosRecientes)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">#@p.PedidoId</td>
                                    <td class="text-muted small">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@p.Cliente?.Nombre</td>
                                    <td class="text-muted">@p.Usuario?.NombreCompleto</td>
                                    <td>
                                        <span class="badge rounded-pill badge-estado-@p.Estado">@p.Estado</span>
                                    </td>
                                    <td class="text-end pe-4 fw-semibold">₡@p.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
